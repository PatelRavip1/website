    <style>
        main {
            margin: auto;
            padding: 2.5rem 3rem;
            width: 1050px;
            max-width: 100%;
            background: var(--ctp-surface0);
            border: 4px solid var(--ctp-surface1);
            box-shadow: 
                0 -4px 0 0 var(--pixel-black),
                0 4px 0 0 var(--pixel-black),
                -4px 0 0 0 var(--pixel-black),
                4px 0 0 0 var(--pixel-black),
                inset 2px 2px 0 0 var(--ctp-surface2),
                inset -2px -2px 0 0 var(--ctp-mantle),
                0 0 18px var(--pixel-glow);
            color: var(--ctp-text);
            font-family: var(--font-mono);
        }

        h2 {
            color: var(--ctp-blue);
            font-size: 1.3rem;
            font-weight: 800;
            margin-top: 1.8rem;
            margin-bottom: 0.6rem;
            border-bottom: 2px solid var(--ctp-surface1);
            padding-bottom: 0.3rem;
            letter-spacing: 0.5px;
        }

        h4 {
            color: var(--ctp-peach);
            font-size: 0.95rem;
            font-weight: 700;
            margin-top: 1rem;
            margin-bottom: 0.4rem;
        }

        ul {
            list-style: none;
            padding-left: 0.4rem;
            margin-top: 0.4rem;
            margin-bottom: 1rem;
        }

        li {
            padding: 0.2rem 0;
            font-size: 0.9rem;
            color: var(--ctp-text);
            line-height: 1.5;
        }

        li::before {
            content: "▶ ";
            color: var(--ctp-blue);
            font-size: 0.72rem;
            margin-right: 0.3rem;
        }

        a {
            color: var(--ctp-blue);
            text-decoration: underline;
            text-underline-offset: 3px;
            transition: color 0.1s ease;
        }

        a:hover {
            color: var(--ctp-lavender);
        }

        div > a[href="/website/"] {
            text-decoration: none;
            color: var(--ctp-blue);
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.4rem 0.8rem;
            background: var(--ctp-mantle);
            border: 2px solid var(--ctp-surface1);
            box-shadow: 2px 2px 0 0 var(--pixel-black);
            display: inline-block;
            margin-bottom: 1rem;
            transition: all 0.1s ease;
        }

        div > a[href="/website/"]:hover {
            border-color: var(--ctp-blue);
            color: var(--ctp-text);
            background: var(--ctp-surface1);
            transform: translate(1px, -1px);
        }
        @media (max-width: 640px) {
            main {
                padding: 1.5rem 1.25rem;
            }
        }
    </style>
</Layout>
