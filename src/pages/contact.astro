---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
    <main>
        <div>
            <a href="/website/"> ↩ back</a>
        </div>
        <h2>Contact</h2>
        <p>
            I am currently available for hire or freelance projects.<br /> Email
            me at <a href="mailto:ravi.prp1997@gmail.com"
                >ravi.prp1997@gmail.com</a
            >
            if you want to chat😄.
            <br />
        </p>
    </main>
</Layout>
<style>
    main {
        margin: auto;
        padding: 2.5rem 3rem;
        width: 1050px;
        max-width: 100%;
        background: var(--ctp-surface0);
        border: 4px solid var(--ctp-surface1);
        box-shadow: 
            0 -4px 0 0 var(--pixel-black),
            0 4px 0 0 var(--pixel-black),
            -4px 0 0 0 var(--pixel-black),
            4px 0 0 0 var(--pixel-black),
            inset 2px 2px 0 0 var(--ctp-surface2),
            inset -2px -2px 0 0 var(--ctp-mantle),
            0 0 18px var(--pixel-glow);
        color: var(--ctp-text);
        font-family: var(--font-mono);
    }

    h2 {
        color: var(--ctp-blue);
        font-size: 1.8rem;
        font-weight: 800;
        margin-top: 0.5rem;
        margin-bottom: 0.8rem;
        letter-spacing: 0.5px;
    }

    p {
        color: var(--ctp-text);
        font-size: 0.95rem;
        line-height: 1.7;
        max-width: 620px;
    }

    a {
        color: var(--ctp-blue);
        text-decoration: underline;
        text-underline-offset: 3px;
        font-weight: 700;
        transition: color 0.1s ease;
    }

    a:hover {
        color: var(--ctp-lavender);
    }

    div > a[href="/website/"] {
        text-decoration: none;
        color: var(--ctp-blue);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.4rem 0.8rem;
        background: var(--ctp-mantle);
        border: 2px solid var(--ctp-surface1);
        box-shadow: 2px 2px 0 0 var(--pixel-black);
        display: inline-block;
        margin-bottom: 1rem;
        transition: all 0.1s ease;
    }

    div > a[href="/website/"]:hover {
        border-color: var(--ctp-blue);
        color: var(--ctp-text);
        background: var(--ctp-surface1);
        transform: translate(1px, -1px);
    }
    @media (max-width: 640px) {
        main {
            padding: 1.5rem 1.25rem;
        }
    }
</style>
