---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Header from "../components/header.astro";
import Nav from "../components/nav.astro";
---

<Layout title="Ravi Patel">
	<main>
		<Header />
		<h1 class="text-gradient">Ravi Patel</h1>
		<p>
			I love to code and learn new things, especially things related to
			computers in general.
		</p>
		<img
			src="/website/github.png"
			alt="My Github profile"
			title="GitHub: @patelravip1"
			class="icon"
			onclick="window.open('https://github.com/patelravip1', target='_blank')"
		/>
		<img
			src="/website/linkedin.png"
			alt="My LinkedIn profile"
			title="LinkedIn: Ravi Patel"
			class="icon"
			onclick="window.open('https://www.linkedin.com/in/ravi-047/', '_blank')"
		/>
		<img
			src="/website/instagram.png"
			alt="My Instagram profile"
			title="Instagram: @rv.047"
			class="icon"
			onclick="window.open('https://www.instagram.com/rv.047/', '_blank')"
		/>
		<br />
		<a href="/website/about/">About</a> |
		<a href="/website/tools/">Tools</a> |
		<a href="/website/contact/">Contact</a>
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 2.5rem 3rem;
		width: 1050px;
		max-width: 100%;
		background: var(--ctp-surface0);
		border: 4px solid var(--ctp-surface1);
		box-shadow: 
			0 -4px 0 0 var(--pixel-black),
			0 4px 0 0 var(--pixel-black),
			-4px 0 0 0 var(--pixel-black),
			4px 0 0 0 var(--pixel-black),
			inset 2px 2px 0 0 var(--ctp-surface2),
			inset -2px -2px 0 0 var(--ctp-mantle),
			0 0 18px var(--pixel-glow);
		color: var(--ctp-text);
		font-family: var(--font-mono);
		position: relative;
	}

	h1 {
		font-size: 2.2rem;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.5px;
		text-align: left;
		margin-bottom: 0.6rem;
		margin-top: 0.5rem;
	}

	.text-gradient {
		background-image: linear-gradient(
			45deg,
			var(--ctp-blue),
			var(--ctp-lavender) 35%,
			var(--ctp-text) 70%
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	p {
		color: var(--ctp-text);
		font-size: 0.95rem;
		line-height: 1.65;
		margin-top: 0;
		margin-bottom: 1.2rem;
		max-width: 620px;
	}

	.icon {
		cursor: pointer;
		height: 2.7rem;
		width: 2.7rem;
		padding: 4px;
		background: var(--ctp-mantle);
		border: 2px solid var(--ctp-surface1);
		box-shadow: 
			2px 2px 0 0 var(--pixel-black),
			inset 1px 1px 0 0 var(--ctp-surface2);
		margin-right: 0.8rem;
		margin-bottom: 1.2rem;
		border-radius: 6px;
		transition: transform 0.1s ease, border-color 0.1s ease, box-shadow 0.1s ease;
		vertical-align: middle;
	}

	.icon:hover {
		border-color: var(--ctp-blue);
		transform: translateY(-2px);
		box-shadow: 
			2px 4px 0 0 var(--pixel-black),
			0 0 10px rgba(137, 180, 250, 0.45);
	}

	.icon:active {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 0 var(--pixel-black);
	}

	a {
		color: var(--ctp-blue);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.88rem;
		padding: 0.4rem 0.8rem;
		background: var(--ctp-mantle);
		border: 2px solid var(--ctp-surface1);
		box-shadow: 2px 2px 0 0 var(--pixel-black);
		display: inline-block;
		margin: 0.5rem 0.3rem 0 0.3rem;
		transition: transform 0.08s ease, border-color 0.1s ease, color 0.1s ease;
	}

	a:hover {
		border-color: var(--ctp-blue);
		color: var(--ctp-text);
		background: var(--ctp-surface1);
		transform: translate(1px, -1px);
	}

	a:active {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 0 var(--pixel-black);
	}

	@media (max-width: 640px) {
		main {
			padding: 1.5rem 1.25rem;
		}
	}
</style>
