---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<!-- make graid of project cards where I can show image and some detail at bottom and  link card to project github links-->
<Layout title="My Projects">
    <main>
        <div>
            <a href="/website/"> ↩ back</a>
        </div>
        <h2>Projects</h2>
        <div class="link-card-grid">
            <!-- https://github.com/PatelRavip1/pygame-dots-and-boxs 
             https://github.com/PatelRavip1/movie_library
             https://github.com/PatelRavip1/Fast-API
             https://github.com/PatelRavip1/Express-API-Email-Attachment
            -->
            <Card
                title="Website"
                body="This is my personal website, built with Astro."
                href="https://github.com/patelravip1/website"
            />
            <Card
                title="Pygame Dots and Boxs"
                body="A simple game made with pygame."
                href="https://github.com/PatelRavip1/pygame-dots-and-boxs"
            />
            <Card
                title="Movie Library"
                body="Movie library built with Rust."
                href="https://github.com/PatelRavip1/movie_library"
            />
            <Card
                title="Fast API"
                body="API boilerplate with FastAPI."
                href="https://github.com/PatelRavip1/Fast-API"
            />
            <Card
                title="Express API Email Attachment"
                body="A script to add attchment in emails."
                href="https://github.com/PatelRavip1/Express-API-Email-Attachment"
            />
        </div>
    </main>
</Layout>

<style>
    main {
        margin: auto;
        padding: 2.5rem 3rem;
        width: 1050px;
        max-width: 100%;
        background: var(--ctp-surface0);
        border: 4px solid var(--ctp-surface1);
        box-shadow: 
            0 -4px 0 0 var(--pixel-black),
            0 4px 0 0 var(--pixel-black),
            -4px 0 0 0 var(--pixel-black),
            4px 0 0 0 var(--pixel-black),
            inset 2px 2px 0 0 var(--ctp-surface2),
            inset -2px -2px 0 0 var(--ctp-mantle),
            0 0 18px var(--pixel-glow);
        color: var(--ctp-text);
        font-family: var(--font-mono);
    }

    h2 {
        color: var(--ctp-blue);
        font-size: 1.8rem;
        font-weight: 800;
        border-bottom: 2px solid var(--ctp-surface1);
        padding-bottom: 0.4rem;
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
        letter-spacing: 0.5px;
    }

    div > a[href="/website/"] {
        text-decoration: none;
        color: var(--ctp-blue);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.4rem 0.8rem;
        background: var(--ctp-mantle);
        border: 2px solid var(--ctp-surface1);
        box-shadow: 2px 2px 0 0 var(--pixel-black);
        display: inline-block;
        margin-bottom: 1rem;
        transition: all 0.1s ease;
    }

    div > a[href="/website/"]:hover {
        border-color: var(--ctp-blue);
        color: var(--ctp-text);
        background: var(--ctp-surface1);
        transform: translate(1px, -1px);
    }

    .link-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        padding: 0;
    }
    @media (max-width: 640px) {
        main {
            padding: 1.5rem 1.25rem;
        }
    }
</style>
